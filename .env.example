# Any node of the cluster; the rest are discovered from /cluster/status.
LXCWATCH_PVE_HOST=
LXCWATCH_SSH_USER=root
# Only needed if node IPs from /cluster/status aren't reachable from here. This
# changes where lxcwatch connects, not which nodes it uses; other nodes still appear.
# LXCWATCH_NODE_ADDRESSES=pve1=10.0.0.11,pve2=10.0.0.12
# Nodes to leave out, with their containers. lxcwatch won't connect to them, and
# forgets those containers' scan results and automatic update settings. Use a
# different node for LXCWATCH_PVE_HOST.
# LXCWATCH_IGNORE_NODES=pve3

# Login for the web UI (sign-in page; HTTP basic auth also works for API clients).
# Put it behind HTTPS (your reverse proxy). Changing the password signs everyone out.
LXCWATCH_USERNAME=admin
LXCWATCH_PASSWORD=change-me
# Optional: skip the sign-in page behind Cloudflare Access. Enabling it needs all
# three settings below; while it's off they're ignored. The application audience
# (AUD) tag is on the Access application's Overview tab.
# LXCWATCH_CF_ACCESS_ENABLED=false
# LXCWATCH_CF_ACCESS_TEAM=myteam
# LXCWATCH_CF_ACCESS_AUD=
# LXCWATCH_CF_ACCESS_EMAILS=you@example.com,other@example.com

# Minutes between automatic scans (0 = only scan on demand).
LXCWATCH_SCAN_INTERVAL_MINUTES=360
# Scans run one interval after the previous one, across restarts.
# overdue: scan at startup only if the last scan is older than the interval
# always:  scan every time lxcwatch starts
# never:   don't scan at startup; first scheduled scan is one interval later
LXCWATCH_SCAN_ON_STARTUP=overdue
# Run apt-get update / apk update inside each container while scanning.
LXCWATCH_REFRESH_PACKAGES=true
# lxcwatch-* snapshots to keep per container after a successful update (0 = keep all).
LXCWATCH_KEEP_SNAPSHOTS=3
LXCWATCH_JOB_CONCURRENCY=2

# Optional: raises the GitHub API limit from 60 to 5000 requests/hour.
# A fine-grained token with no permissions is enough.
# LXCWATCH_GITHUB_TOKEN=

# Notifications when a scan finds something new (each update is announced once).
# LXCWATCH_NTFY_URL=https://ntfy.example.com/lxc-updates
# LXCWATCH_NTFY_TOKEN=
# Pushover: an application token (pushover.net/apps/build) and your user key.
# LXCWATCH_PUSHOVER_TOKEN=
# LXCWATCH_PUSHOVER_USER=
# LXCWATCH_WEBHOOK_URL=
# none | security | all
LXCWATCH_NOTIFY_PACKAGES=security
# Check for new lxcwatch releases (header badge plus one notification per version).
# LXCWATCH_UPDATE_CHECK=true
# Link included in notifications.
# LXCWATCH_PUBLIC_URL=https://lxcwatch.example.com
